# SyncPulse Configuration Example
# Copy to .env and adjust as needed. Never commit .env to Git.

# HTTP API Server (bind 0.0.0.0 only on trusted private LAN for iPhone Safari access)
SYNCPULSE_API_HOST=0.0.0.0
SYNCPULSE_API_PORT=8000

# Backup Worker TCP Socket (loopback-only by default for safety)
SYNCPULSE_TCP_HOST=127.0.0.1
SYNCPULSE_TCP_PORT=9101

# Monitoring UDP Heartbeat (loopback-only by default)
SYNCPULSE_UDP_HOST=127.0.0.1
SYNCPULSE_UDP_PORT=9102

# Transfer limits & timeouts
SYNCPULSE_MAX_FILE_SIZE_BYTES=52428800
SYNCPULSE_MAX_METADATA_BYTES=16384
SYNCPULSE_CHUNK_SIZE_BYTES=65536
SYNCPULSE_TCP_TIMEOUT_SECONDS=30.0

# Heartbeat timing (experimental local defaults)
SYNCPULSE_HEARTBEAT_INTERVAL_SECONDS=1.0
SYNCPULSE_HEARTBEAT_TIMEOUT_SECONDS=4.0
SYNCPULSE_WORKER_ID=backup-worker-1

# Storage directory (relative to project root or absolute)
SYNCPULSE_DATA_DIR=data

# Fault injection options (0 = disabled, for testing/demo only)
SYNCPULSE_UDP_DROP_EVERY_N=0
SYNCPULSE_TCP_THROTTLE_MS=0
